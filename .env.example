# ---- Discord -------------------------------------------------------------
# User token from the throwaway account. See README for how to grab it.
# No "Bot " prefix. Rotates whenever that account changes password or logs out
# of all devices.
DISCORD_TOKEN=

# Guild to watch.
GUILD_ID=

# ---- Telegram ------------------------------------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Your numeric chat id. See README for how to find it.
TELEGRAM_CHAT_ID=

# ---- Behaviour -----------------------------------------------------------
# Seconds between polls. 300 is a reasonable floor; don't go below ~60.
POLL_INTERVAL_SECONDS=120

# Randomizes each interval by +/- this fraction so the cadence isn't robotic.
POLL_JITTER=0.5

# Notify when an existing event changes time/title/status.
NOTIFY_UPDATES=true

# Notify when an event disappears or is cancelled.
NOTIFY_CANCELLATIONS=true

# On the very first run there's no baseline. false = silently record whatever
# already exists; true = send a message for every current event.
ANNOUNCE_ON_FIRST_RUN=true

LOG_LEVEL=INFO
